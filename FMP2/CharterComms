"""
Black-Scholes: Performance-Vesting Option Tiers vs RSU
=======================================================
European call, no dividends.

Each tier is defined as a % increase target over today's stock price.
Tiers are INCLUSIVE: hitting a higher tier unlocks all lower tiers too.
The cumulative payoff in Chart 4 reflects this stacking structure.

Charts:
  1 (top-left)  — Tier 1 option vs 1 RSU (single-unit reference)
  2 (top-right) — Equal grant-value: scaled Tier-1 options vs 1 RSU
  3 (bot-left)  — All 5 tiers individually (per unit)
  4 (bot-right) — CUMULATIVE inclusive package payoff vs RSU total
"""

import numpy as np
from scipy.stats import norm
from datetime import datetime
import matplotlib.pyplot as plt
import matplotlib.ticker as mticker


# ─────────────────────────────────────────────
#  INPUT HELPERS
# ─────────────────────────────────────────────

def get_float(prompt, positive=True):
    while True:
        raw = input(prompt).strip().replace(",", "").replace("$", "").replace("%", "")
        try:
            val = float(raw)
            if positive and val <= 0:
                print("   ✗ Must be a positive number. Try again.")
                continue
            return val
        except ValueError:
            print(f"   ✗ '{raw}' is not a valid number. Try again.")

def get_int(prompt):
    while True:
        raw = input(prompt).strip().replace(",", "")
        try:
            val = int(raw)
            if val <= 0:
                print("   ✗ Must be a positive integer. Try again.")
                continue
            return val
        except ValueError:
            print(f"   ✗ '{raw}' is not a valid integer. Try again.")

def get_date(prompt):
    while True:
        raw = input(prompt).strip()
        try:
            return datetime.strptime(raw, "%Y-%m-%d")
        except ValueError:
            print("   ✗ Invalid date. Use YYYY-MM-DD (e.g. 2026-03-31).")


# ─────────────────────────────────────────────
#  MAIN INPUTS
# ─────────────────────────────────────────────

print("\n" + "=" * 60)
print("   Black-Scholes: Performance-Tier Option vs RSU Analyzer")
print("=" * 60)
print("   Numbers without commas  (e.g. 1000 not 1,000)")
print("   Rates as decimals        (e.g. 0.05 for 5%)")
print("=" * 60)

S     = get_float("\n Current stock price (S)              : ")
r     = get_float(" Risk-free rate, annual (0.05 = 5%)   : ", positive=False)
sigma = get_float(" Volatility, annual    (0.25 = 25%)   : ")

today    = get_date(" Today's date          (YYYY-MM-DD)   : ")
maturity = get_date(" Maturity date         (YYYY-MM-DD)   : ")
T        = (maturity - today).days / 365.0

while T <= 0:
    print("   ✗ Maturity must be after today. Try again.")
    maturity = get_date(" Maturity date         (YYYY-MM-DD)   : ")
    T        = (maturity - today).days / 365.0

print(f"\n → Time to maturity: {T:.4f} years  ({(maturity - today).days} days)\n")

n_options = get_int(" Number of options per tier (same for all 5): ")

print(f"\n Enter 5 performance targets as % increase over S = ${S:,.2f}")
print(f" Example: 10 = +10% → strike ${S*1.10:,.2f}  |  25 = +25% → ${S*1.25:,.2f}\n")

pcts = []
for i in range(5):
    pct = get_float(f"   Tier {i+1} target — % increase over S (e.g. 10 for +10%): ")
    pcts.append(pct)

# Sort ascending so tiers go from easiest to hardest
pcts_sorted = sorted(pcts)
if pcts_sorted != pcts:
    print("\n   ⚠  Tiers re-sorted ascending (easiest → hardest unlock).")
    pcts = pcts_sorted

strikes = [S * (1 + p / 100) for p in pcts]


# ─────────────────────────────────────────────
#  BLACK-SCHOLES PRICER
# ─────────────────────────────────────────────

def black_scholes_call(S, K, T, r, sigma):
    """European call, no dividends."""
    d1 = (np.log(S / K) + (r + 0.5 * sigma**2) * T) / (sigma * np.sqrt(T))
    d2 = d1 - sigma * np.sqrt(T)

    price = S * norm.cdf(d1) - K * np.exp(-r * T) * norm.cdf(d2)
    delta = norm.cdf(d1)
    gamma = norm.pdf(d1) / (S * sigma * np.sqrt(T))
    vega  = S * norm.pdf(d1) * np.sqrt(T) / 100
    theta = (-(S * norm.pdf(d1) * sigma) / (2 * np.sqrt(T))
             - r * K * np.exp(-r * T) * norm.cdf(d2)) / 365
    rho   = K * T * np.exp(-r * T) * norm.cdf(d2) / 100

    greeks = {
        "Delta":             delta,
        "Gamma":             gamma,
        "Vega (per 1% vol)": vega,
        "Theta (per day)":   theta,
        "Rho (per 1% rate)": rho,
    }
    return price, d1, d2, greeks


# ─────────────────────────────────────────────
#  COMPUTE ALL TIERS
# ─────────────────────────────────────────────

tiers = []
for pct, K_i in zip(pcts, strikes):
    price, d1, d2, greeks = black_scholes_call(S, K_i, T, r, sigma)
    tiers.append({
        "pct":       pct,
        "K":         K_i,
        "price":     price,
        "grant_val": price * n_options,
        "d1": d1, "d2": d2,
        "greeks":    greeks,
    })

rsu_unit_val  = S
rsu_total_val = S * n_options
total_option_grant_val = sum(t["grant_val"] for t in tiers)

# Reference for Charts 1 & 2: Tier 1 (first / easiest unlock)
ref = tiers[0]


# ─────────────────────────────────────────────
#  CONSOLE SUMMARY
# ─────────────────────────────────────────────

print("\n" + "=" * 72)
print(f"  INPUTS:  S=${S:,.2f}  r={r*100:.1f}%  σ={sigma*100:.1f}%  "
      f"T={T:.3f}yr  n={n_options:,}/tier")
print("=" * 72)
print(f"\n  {'Tier':<6} {'Target':>7} {'Strike':>9} {'BS Price':>10} "
      f"{'Grant Value':>13} {'Cumul. GV':>13} {'Delta':>8}")
print("  " + "─" * 70)

cumul_gv = 0
for i, t in enumerate(tiers):
    cumul_gv += t["grant_val"]
    print(f"  T{i+1:<5} +{t['pct']:>5.1f}%  ${t['K']:>8,.2f} "
          f"${t['price']:>9,.4f} ${t['grant_val']:>12,.2f} "
          f"${cumul_gv:>12,.2f} {t['greeks']['Delta']:>8.4f}")

print("  " + "─" * 70)
print(f"  {'RSU':<6} {'—':>7} ${S:>9,.2f} ${S:>9,.4f} ${rsu_total_val:>12,.2f}  (linear, n={n_options:,})")
print(f"\n  Total option grant value (all tiers): ${total_option_grant_val:,.2f}")
print(f"  RSU grant value:                      ${rsu_total_val:,.2f}")
print("=" * 72)

print(f"\n  GREEKS DETAIL PER TIER\n")
for i, t in enumerate(tiers):
    print(f"  Tier {i+1}  +{t['pct']:.1f}%  K=${t['K']:,.2f}  d1={t['d1']:.4f}  d2={t['d2']:.4f}")
    for gname, gval in t["greeks"].items():
        print(f"    {gname:<22}: {gval:+.6f}")
    print()
print("=" * 72 + "\n")


# ─────────────────────────────────────────────
#  CHARTS
# ─────────────────────────────────────────────

TIER_COLORS = ["#e74c3c", "#e67e22", "#f1c40f", "#2ecc71", "#3498db"]
RSU_COLOR   = "#f7931e"
REF_COLOR   = "#00d4aa"
CURR_CLR    = "#888888"
BG          = "#0f1117"
PANEL_BG    = "#1a1d27"

S_range = np.linspace(S * 0.5, S * 2.8, 700)

fig, axes = plt.subplots(2, 2, figsize=(16, 12))
fig.patch.set_facecolor(BG)

def style_ax(ax):
    ax.set_facecolor(PANEL_BG)
    ax.tick_params(colors="#aaaaaa", labelsize=9)
    for sp in ["bottom", "left"]:
        ax.spines[sp].set_color("#444")
    for sp in ["top", "right"]:
        ax.spines[sp].set_visible(False)
    ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f"${x:,.0f}"))
    ax.xaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f"${x:,.0f}"))
    ax.grid(True, color="#252836", lw=0.5, zorder=0)
    ax.axhline(0, color="#555", lw=0.8, zorder=1)
    ax.axvline(S, color=CURR_CLR, lw=1.0, ls=":", zorder=2, label=f"S₀ = ${S:,.0f}")


# ── Chart 1: Tier 1 option vs 1 RSU (per unit) ───────────────────────────
ax1 = axes[0, 0]
style_ax(ax1)

pay_ref  = np.maximum(S_range - ref["K"], 0)
pay_rsu1 = S_range

ax1.plot(S_range, pay_ref,  color=REF_COLOR, lw=2.2,
         label=f"Tier 1 Call  K=${ref['K']:,.0f}  (+{ref['pct']:.0f}%)")
ax1.plot(S_range, pay_rsu1, color=RSU_COLOR,  lw=2.2, label="RSU (1 share)")
ax1.axvline(ref["K"], color=REF_COLOR, lw=1.0, ls="--", alpha=0.6,
            label=f"Unlock @ +{ref['pct']:.0f}%")
ax1.set_title("① Tier 1 Option vs 1 RSU — Per Unit Payoff",
              color="white", fontsize=11, pad=10)
ax1.set_xlabel("Stock price at expiry (Sₜ)", color="#aaaaaa", fontsize=9)
ax1.set_ylabel("Payoff ($)", color="#aaaaaa", fontsize=9)
ax1.legend(facecolor=PANEL_BG, edgecolor="#333", labelcolor="white", fontsize=9)


# ── Chart 2: Equal grant-value comparison (Tier 1 ref) ───────────────────
ax2 = axes[0, 1]
style_ax(ax2)

n_scaled       = rsu_unit_val / ref["price"]
scaled_opt_pay = np.maximum(S_range - ref["K"], 0) * n_scaled

ax2.plot(S_range, scaled_opt_pay, color=REF_COLOR, lw=2.2,
         label=f"Tier 1 Options ×{n_scaled:.1f}\n(= 1 RSU grant value)")
ax2.plot(S_range, pay_rsu1,       color=RSU_COLOR,  lw=2.2, label="1 RSU")
ax2.axvline(ref["K"], color=REF_COLOR, lw=1.0, ls="--", alpha=0.6,
            label=f"Unlock @ +{ref['pct']:.0f}%")
ax2.set_title("② Equal Grant-Value: Tier 1 Options vs 1 RSU",
              color="white", fontsize=11, pad=10)
ax2.set_xlabel("Stock price at expiry (Sₜ)", color="#aaaaaa", fontsize=9)
ax2.set_ylabel("Executive payoff ($)", color="#aaaaaa", fontsize=9)
ax2.legend(facecolor=PANEL_BG, edgecolor="#333", labelcolor="white", fontsize=9)


# ── Chart 3: All 5 tiers individually (per unit) ─────────────────────────
ax3 = axes[1, 0]
style_ax(ax3)

for i, t in enumerate(tiers):
    pay = np.maximum(S_range - t["K"], 0)
    ax3.plot(S_range, pay, color=TIER_COLORS[i], lw=2.0,
             label=f"T{i+1}  +{t['pct']:.0f}%  K=${t['K']:,.0f}")
    ax3.axvline(t["K"], color=TIER_COLORS[i], lw=0.7, ls="--", alpha=0.4)

ax3.plot(S_range, S_range, color=RSU_COLOR, lw=2.0, ls="-.", label="RSU (1 share)")
ax3.set_title("③ All 5 Tiers Individually — Per Unit Payoff",
              color="white", fontsize=11, pad=10)
ax3.set_xlabel("Stock price at expiry (Sₜ)", color="#aaaaaa", fontsize=9)
ax3.set_ylabel("Payoff per option / share ($)", color="#aaaaaa", fontsize=9)
ax3.legend(facecolor=PANEL_BG, edgecolor="#333", labelcolor="white",
           fontsize=8, loc="upper left")


# ── Chart 4: CUMULATIVE inclusive package payoff ──────────────────────────
# At each S_T, exec collects ALL tiers where K_i ≤ S_T (inclusive stacking).
# Slope steepens each time a new tier unlocks — that's the incentive gradient.

ax4 = axes[1, 1]
style_ax(ax4)

# Cumulative payoff = Σ max(S_T - K_i, 0) × n_options  for all i
cumul_payoff = sum(np.maximum(S_range - t["K"], 0) * n_options for t in tiers)
rsu_total_payoff = S_range * n_options

# Shade between tier unlock points to highlight steepening slope
prev_K = S
for i, t in enumerate(tiers):
    # Region where tier i+1 is the latest unlock
    next_K = tiers[i+1]["K"] if i + 1 < len(tiers) else S_range[-1]
    mask = (S_range >= t["K"]) & (S_range < next_K)
    ax4.fill_between(S_range, 0, cumul_payoff,
                     where=mask, color=TIER_COLORS[i], alpha=0.12, zorder=1)

# Vertical unlock lines with labels
for i, t in enumerate(tiers):
    ax4.axvline(t["K"], color=TIER_COLORS[i], lw=0.9, ls="--", alpha=0.5)
    ax4.text(t["K"], ax4.get_ylim()[1] if ax4.get_ylim()[1] > 0 else 1,
             f" +{t['pct']:.0f}%", color=TIER_COLORS[i],
             fontsize=7.5, va="top", rotation=90, alpha=0.85)

ax4.plot(S_range, cumul_payoff,    color="#e056fd", lw=2.5, zorder=3,
         label=f"Cumulative all tiers (×{n_options:,} each)")
ax4.plot(S_range, rsu_total_payoff, color=RSU_COLOR,  lw=2.0, ls="-.", zorder=3,
         label=f"RSU ×{n_options:,}  GV=${rsu_total_val:,.0f}")

ax4.set_title(
    f"④ Cumulative Inclusive Package  —  Each tier unlocked as stock hits target",
    color="white", fontsize=11, pad=10)
ax4.set_xlabel("Stock price at expiry (Sₜ)", color="#aaaaaa", fontsize=9)
ax4.set_ylabel("Total executive payoff ($)", color="#aaaaaa", fontsize=9)

# Re-draw unlock labels now that y-lim is set
ymax = max(cumul_payoff.max(), rsu_total_payoff.max()) * 1.05
ax4.set_ylim(bottom=0, top=ymax)
for i, t in enumerate(tiers):
    ax4.text(t["K"] + S * 0.005, ymax * 0.97,
             f"+{t['pct']:.0f}%\nT{i+1}",
             color=TIER_COLORS[i], fontsize=7.5, va="top", alpha=0.9)

ax4.legend(facecolor=PANEL_BG, edgecolor="#333", labelcolor="white",
           fontsize=9, loc="upper left")


plt.suptitle(
    f"Performance-Vesting Option Tiers vs RSU  |  S₀=${S:,.0f}  "
    f"σ={sigma*100:.0f}%  r={r*100:.0f}%  T={T:.2f}yr  n={n_options:,}/tier  "
    f"[Tiers: {' → '.join(f'+{p:.0f}%' for p in pcts)}]",
    color="white", fontsize=10, y=1.01
)
plt.tight_layout()

outfile = "bs_rsu_perf_tiers.png"
plt.savefig(outfile, dpi=150, bbox_inches="tight", facecolor=BG)
print(f"Chart saved → {outfile}\n")
plt.show()